# ---- Python ----
__pycache__/
*.py[cod]
*.so
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Environment / secrets ----
.env
.env.local
*.pem
*.key

# ---- Node / frontend ----
node_modules/
dist/
.vite/
*.local

# ---- ML artefacts (never commit these) ----
# Ignore everything under backend/models/ (the trained weight files — up to
# ~800MB combined — plus their tokenizer/config sidecar files) except a
# .gitkeep per modality folder, so the empty directory layout documented in
# README.md still ships in a fresh clone. This used to be a set of
# extension patterns (models/**/*.pth etc.) rooted at the repo root, which
# never actually matched anything here since the real weights live under
# backend/models/, not a root-level models/ — fixed to point at the real
# path and to ignore the whole tree rather than only specific extensions.
backend/models/**
!backend/models/**/
!backend/models/**/.gitkeep
checkpoints/
mlruns/
wandb/
chroma_db/
backend/storage/
storage/
backend/data/
data/
*.npy
*.npz

# ---- Runtime ----
backend/uploads/**
!backend/uploads/**/
!backend/uploads/**/.gitkeep
logs/
*.log
*.db
*.sqlite3

# ---- Notebooks ----
.ipynb_checkpoints/

# ---- OS / IDE ----
.DS_Store
Thumbs.db
.idea/
.vscode/
